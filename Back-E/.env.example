APP_NAME=EstiloEsmeralda
APP_ENV=production
# Nunca publiques claves reales en .env.example. Deja vacío o usa un placeholder.
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-backend-render

APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=tu-host-bd
DB_PORT=3306
DB_DATABASE=tu-bd
DB_USERNAME=tu-usuario
DB_PASSWORD=tu-password

# TLS para MySQL (requerido por TiDB Serverless)
# En Render/Ubuntu suele existir este bundle del sistema.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# Pon en true si quieres validar el cert del servidor (requiere CA correcta)
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

SESSION_DOMAIN=.onrender.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=None
SESSION_PARTITIONED_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Opción recomendada: SendGrid por API (estable y evita bloqueos de puertos)
MAIL_MAILER=sendgrid
# Alternativa SMTP (si prefieres usar SMTP, cambia MAIL_MAILER=smtp y configura host/port/user/pass)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
# Reemplaza con tu clave de API real en .env (NO en .env.example)
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tu-correo@dominio.com"
MAIL_FROM_NAME="Estilo Esmeralda"

# Alternativa recomendada en PaaS: usar SendGrid por API (evita bloqueos de puertos)
# Si usas esta opción, establece MAIL_MAILER=sendgrid y define SENDGRID_API_KEY
SENDGRID_API_KEY=

FORTIFY_URL=https://tu-frontend
# Lista separada por comas de hosts (sin protocolo) que compartirán sesión
SANCTUM_STATEFUL_DOMAINS=e-commerce-esmeralda.vercel.app

# Solo para depurar correo en producción con /debug-mail?key=...
# Coloca un valor aleatorio largo aquí en tu .env real
DEBUG_KEY=
# Dirección destino por defecto para /debug-mail (opcional)
MAIL_TEST_TO=